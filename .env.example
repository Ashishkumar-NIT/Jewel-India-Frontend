# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Backend API URL
# Local: http://localhost:8000
# Production: https://your-backend-api.up.railway.app
NEXT_PUBLIC_API_URL=https://your-backend-api.up.railway.app

# Site URL (Optional for local development)
# For local development, uncomment this and set it to http://localhost:3000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
